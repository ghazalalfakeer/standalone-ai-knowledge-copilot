# Task 2 application configuration
APP_NAME=Standalone AI Knowledge Copilot
APP_ENV=development
LOG_LEVEL=INFO
DATA_FILE=data/sample_knowledge.json

# Task 3 Gemini / LLM configuration

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=768

# Optional: configure CURRENT paid-tier prices only after checking Google's
# official pricing page. Leaving these unset disables cost estimation.
# GEMINI_INPUT_COST_PER_1M_USD=0.75
# GEMINI_OUTPUT_COST_PER_1M_USD=3.75
